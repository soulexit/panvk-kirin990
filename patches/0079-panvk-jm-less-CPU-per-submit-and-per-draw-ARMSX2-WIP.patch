diff --git a/src/panfrost/lib/kmod/kbase_kmod.c b/src/panfrost/lib/kmod/kbase_kmod.c
index 843418cfbe2..93187ac7318 100644
--- a/src/panfrost/lib/kmod/kbase_kmod.c
+++ b/src/panfrost/lib/kmod/kbase_kmod.c
@@ -203,6 +203,10 @@ struct kbase_atom_slot {
 struct kbase_kmod_dev {
    struct pan_kmod_dev base;
 
+   /* jm-v7 128: the fd is O_NONBLOCK, so events are read until EAGAIN
+    * without a poll(0) before each read(). */
+   bool nonblock_events;
+
    /* True for the CSF flavour of kbase (arch >= 10), false for JM. */
    bool is_csf;
 
@@ -2117,6 +2121,13 @@ kbase_kmod_dev_create(int fd, uint32_t flags,
       kbase_dev->atom_seq_nr = atom_seq_nr;
       simple_mtx_init(&kbase_dev->atoms_lock, mtx_plain);
       simple_mtx_init(&kbase_dev->atoms_read_lock, mtx_plain);
+      /* kbase_read() returns -EAGAIN on an empty queue with O_NONBLOCK.
+       * PANVK_KBASE_NONBLOCK=0: blocking fd, poll before every read. */
+      const char *nb = getenv("PANVK_KBASE_NONBLOCK");
+      const int fl = fcntl(fd, F_GETFL);
+      if (!(nb && nb[0] == '0') && fl >= 0 &&
+          fcntl(fd, F_SETFL, fl | O_NONBLOCK) == 0)
+         kbase_dev->nonblock_events = true;
    }
 
    if (is_csf && kbase_query_csif_info(fd, &kbase_dev->csif_info)) {
@@ -3507,18 +3518,23 @@ kbase_atom_process_event_locked(struct kbase_kmod_dev *kd,
 static int
 kbase_drain_events(struct kbase_kmod_dev *kd, int timeout_ms)
 {
-   struct pollfd pfd = { .fd = kd->base.fd, .events = POLLIN };
-   int ret = poll(&pfd, 1, timeout_ms);
-   if (ret <= 0)
-      return ret < 0 && errno != EINTR ? -1 : 0;
-   if (!(pfd.revents & POLLIN))
-      return -1;
+   /* jm-v7 128: with a non-blocking fd a zero timeout needs no poll(), and
+    * the loop below reads until EAGAIN instead of polling before each
+    * read: syscalls take the slow (traced) path on Android, and these were
+    * most of the event handling's cost in ARMSX2's render thread. */
+   if (!kd->nonblock_events || timeout_ms != 0) {
+      struct pollfd pfd = { .fd = kd->base.fd, .events = POLLIN };
+      int ret = poll(&pfd, 1, timeout_ms);
+      if (ret <= 0)
+         return ret < 0 && errno != EINTR ? -1 : 0;
+      if (!(pfd.revents & POLLIN))
+         return -1;
+   }
 
    /* jm-v7 114: up to 16 events per read(). kbase_read() copies queued
     * events while the buffer has room and returns as soon as the queue is
     * empty once it has copied one, so a short read means the queue was
-    * drained and no further poll() is needed. Before, every event cost a
-    * poll() plus a read(). PANVK_KBASE_EVENT_BATCH=0 = one per read (old).
+    * drained. PANVK_KBASE_EVENT_BATCH=0 = one per read (old).
     */
    static int ev_batch = -1;
    if (ev_batch < 0) {
@@ -3526,18 +3542,21 @@ kbase_drain_events(struct kbase_kmod_dev *kd, int timeout_ms)
       ev_batch = !(e && e[0] == '0');
    }
    const unsigned max_ev = ev_batch ? 16 : 1;
+   int ret = 0;
 
    simple_mtx_lock(&kd->atoms_read_lock);
    for (unsigned i = 0; i < KBASE_MAX_ATOMS; i++) {
-      struct pollfd rfd = { .fd = kd->base.fd, .events = POLLIN };
-      ret = poll(&rfd, 1, 0);
-      if (ret <= 0) {
-         ret = ret < 0 && errno != EINTR ? -1 : 0;
-         break;
-      }
-      if (!(rfd.revents & POLLIN)) {
-         ret = -1;
-         break;
+      if (!kd->nonblock_events) {
+         struct pollfd rfd = { .fd = kd->base.fd, .events = POLLIN };
+         ret = poll(&rfd, 1, 0);
+         if (ret <= 0) {
+            ret = ret < 0 && errno != EINTR ? -1 : 0;
+            break;
+         }
+         if (!(rfd.revents & POLLIN)) {
+            ret = -1;
+            break;
+         }
       }
 
       struct base_jd_event_v2 ev[16];
@@ -3545,6 +3564,10 @@ kbase_drain_events(struct kbase_kmod_dev *kd, int timeout_ms)
       do {
          n = read(kd->base.fd, ev, max_ev * sizeof(ev[0]));
       } while (n < 0 && errno == EINTR);
+      if (n < 0 && kd->nonblock_events && errno == EAGAIN) {
+         ret = 0;
+         break;
+      }
       if (n <= 0 || n % (ssize_t)sizeof(ev[0])) {
          ret = -1;
          break;
@@ -3578,6 +3601,70 @@ kbase_reclaim_completed(struct kbase_kmod_dev *kd)
    return n;
 }
 
+/* jm-v7 125: the atoms of one vkQueueSubmit go to the kernel in one
+ * JOB_SUBMIT (it takes an array) instead of one ioctl each: 5.6% of
+ * ARMSX2's render thread was those ioctls (about 3800 a second). Per thread:
+ * between kbase_kmod_jm_defer_begin() and _end() the atoms are kept here.
+ * Anything that could wait for one of them, or submit an atom right away
+ * (a pre-dependency on a number the kernel has not seen yet counts as
+ * met), sends them first. PANVK_JM_SUBMIT_BATCH=0: one ioctl per atom. */
+#define KBASE_DEFER_MAX 64
+#define KBASE_DEFER_STRIDE_MAX 72
+static __thread struct {
+   struct kbase_kmod_dev *kd;
+   unsigned n;
+   struct kbase_atom_slot *slots[KBASE_DEFER_MAX];
+   uint8_t buf[KBASE_DEFER_MAX * KBASE_DEFER_STRIDE_MAX];
+} kbase_defer;
+
+static void
+kbase_defer_flush(void)
+{
+   struct kbase_kmod_dev *kd = kbase_defer.kd;
+   if (!kd || !kbase_defer.n)
+      return;
+   struct kbase_ioctl_job_submit sub = {
+      .addr = (uintptr_t)kbase_defer.buf,
+      .nr_atoms = kbase_defer.n,
+      .stride = kd->atom_stride,
+   };
+   if (ioctl(kd->base.fd, KBASE_IOCTL_JOB_SUBMIT, &sub) < 0) {
+      mesa_loge("kbase: JOB_SUBMIT of %u atoms failed: %s", kbase_defer.n,
+                strerror(errno));
+      simple_mtx_lock(&kd->atoms_lock);
+      for (unsigned i = 0; i < kbase_defer.n; i++)
+         kbase_defer.slots[i]->atom_number = 0;
+      simple_mtx_unlock(&kd->atoms_lock);
+   }
+   kbase_defer.n = 0;
+}
+
+void
+kbase_kmod_jm_defer_begin(struct pan_kmod_dev *dev)
+{
+   struct kbase_kmod_dev *kd = container_of(dev, struct kbase_kmod_dev, base);
+   static int on = -1;
+   if (on < 0) {
+      const char *e = getenv("PANVK_JM_SUBMIT_BATCH");
+      on = !(e && e[0] == '0');
+   }
+   if (!on || kd->is_csf || kd->atom_stride > KBASE_DEFER_STRIDE_MAX)
+      return;
+   kbase_defer_flush();
+   kbase_defer.kd = kd;
+   kbase_defer.n = 0;
+}
+
+void
+kbase_kmod_jm_defer_end(struct pan_kmod_dev *dev)
+{
+   struct kbase_kmod_dev *kd = container_of(dev, struct kbase_kmod_dev, base);
+   if (kbase_defer.kd != kd)
+      return;
+   kbase_defer_flush();
+   kbase_defer.kd = NULL;
+}
+
 static struct kbase_atom_slot *
 kbase_atom_alloc(struct kbase_kmod_dev *kd, struct pan_kmod_bo **bos,
                  uint32_t nbo, uint32_t core_req, bool no_waiter)
@@ -3587,6 +3674,8 @@ kbase_atom_alloc(struct kbase_kmod_dev *kd, struct pan_kmod_bo **bos,
          kbase_atom_alloc_try(kd, bos, nbo, core_req, no_waiter);
       if (s)
          return s;
+      /* The table may be full of atoms this thread has not sent yet. */
+      kbase_defer_flush();
       if (kbase_drain_events(kd, 0) < 0)
          return NULL;
       if (!kbase_reclaim_completed(kd) && kbase_drain_events(kd, 1) < 0)
@@ -3607,6 +3696,7 @@ kbase_wait_atom(struct kbase_kmod_dev *kd, uint64_t atom_num,
       errno = EINVAL;
       return false;
    }
+   kbase_defer_flush();
 
    int64_t deadline = timeout_ns < 0 ? -1 :
                       os_time_get_absolute_timeout(timeout_ns);
@@ -3644,6 +3734,9 @@ kbase_wait_atom(struct kbase_kmod_dev *kd, uint64_t atom_num,
       }
       simple_mtx_unlock(&kd->atoms_lock);
 
+      /* 1 ms steps: another thread may read this atom's event between the
+       * check above and poll(), and only the timeout wakes this one then.
+       * 8 ms steps (jm-v7 126, tried) lost ARMSX2 about 20% of its fps. */
       if (deadline >= 0 && os_time_get_nano() >= deadline)
          return false;
       if (kbase_drain_events(kd, 1) < 0)
@@ -3667,6 +3760,7 @@ kbase_kmod_job_submit(struct pan_kmod_dev *dev, uint64_t jc,
       return 0;
    }
 
+   kbase_defer_flush();
    struct kbase_atom_slot *slot =
       kbase_atom_alloc(kd, bos, nbo, core_req, false);
    if (!slot)
@@ -3738,6 +3832,15 @@ kbase_kmod_job_submit_dep(struct pan_kmod_dev *dev, uint64_t jc,
       __u64 seq_nr;
       struct base_jd_atom atom;
    } w = { .atom = atom };
+   if (kbase_defer.kd == kd) {
+      if (kbase_defer.n == KBASE_DEFER_MAX)
+         kbase_defer_flush();
+      memcpy(kbase_defer.buf + kbase_defer.n * kd->atom_stride,
+             kd->atom_seq_nr ? (const void *)&w : (const void *)&atom,
+             kd->atom_stride);
+      kbase_defer.slots[kbase_defer.n++] = slot;
+      return atom.atom_number;
+   }
    struct kbase_ioctl_job_submit sub = {
       .addr = kd->atom_seq_nr ? (uintptr_t)&w : (uintptr_t)&atom,
       .nr_atoms = 1,
@@ -3820,6 +3923,7 @@ kbase_kmod_jm_export_fence(struct pan_kmod_dev *dev, uint64_t dep0,
          close(fd);
    }
 
+   kbase_defer_flush();
    struct kbase_atom_slot *slot =
       kbase_atom_alloc(kd, NULL, 0, KBASE_JD_REQ_SOFT_FENCE_TRIGGER, true);
    if (!slot)
