diff --git a/src/panfrost/vulkan/jm/panvk_vX_gpu_queue.c b/src/panfrost/vulkan/jm/panvk_vX_gpu_queue.c
index 1d0d7cd8381..00ab3da738a 100644
--- a/src/panfrost/vulkan/jm/panvk_vX_gpu_queue.c
+++ b/src/panfrost/vulkan/jm/panvk_vX_gpu_queue.c
@@ -231,6 +231,23 @@ static unsigned panvk_diag_hist_n;
 static bool panvk_diag_hist_dumped;
 static simple_mtx_t panvk_diag_hist_lock = SIMPLE_MTX_INITIALIZER;
 
+/* jm-v7 126: the job history's clock. clock_gettime() was a real system
+ * call on the Galaxy A51's kernel (vDSO off for its timer), 1.2% of
+ * ARMSX2's render thread for one call per atom; the history only needs
+ * relative milliseconds, so the virtual counter is read directly. */
+static inline uint64_t
+panvk_diag_now_ns(void)
+{
+#if defined(__aarch64__)
+   uint64_t cnt, frq;
+   __asm__ volatile("mrs %0, cntvct_el0" : "=r"(cnt));
+   __asm__ volatile("mrs %0, cntfrq_el0" : "=r"(frq));
+   if (frq)
+      return (uint64_t)((__uint128_t)cnt * 1000000000ull / frq);
+#endif
+   return os_time_get_nano();
+}
+
 static void
 panvk_diag_hist_done(unsigned atom)
 {
@@ -238,7 +255,7 @@ panvk_diag_hist_done(unsigned atom)
    for (unsigned i = 0; i < 128 && i < panvk_diag_hist_n; i++) {
       struct panvk_diag_hist *h = &panvk_diag_hist[(panvk_diag_hist_n - 1 - i) & 127];
       if (h->atom == atom && !h->done_ns) {
-         h->done_ns = os_time_get_nano();
+         h->done_ns = panvk_diag_now_ns();
          break;
       }
    }
@@ -263,7 +280,7 @@ panvk_diag_atom_failed(unsigned atom)
    simple_mtx_lock(&panvk_diag_hist_lock);
    if (!panvk_diag_hist_dumped && panvk_diag_hist_n) {
       panvk_diag_hist_dumped = true;
-      const uint64_t now = os_time_get_nano();
+      const uint64_t now = panvk_diag_now_ns();
       const unsigned n = MIN2(panvk_diag_hist_n, 128);
       mesa_loge("panvk: last %u atoms before the failure (ms before now):", n);
       panvk_errlog("last %u jobs before the failure (ms before now):", n);
@@ -437,6 +454,10 @@ panvk_gprof_report_locked(uint64_t now)
       const uint64_t dcg = p_atomic_xchg(&panvk_mem_stats.desc_copy_gpu, 0);
       mesa_logi("GPROF descriptor copies/s: CPU %.0f, GPU job %.0f",
                 dcc / secs, dcg / secs);
+      const uint64_t prh = p_atomic_xchg(&panvk_mem_stats.push_reuse_hit, 0);
+      const uint64_t prm = p_atomic_xchg(&panvk_mem_stats.push_reuse_miss, 0);
+      mesa_logi("GPROF push uniform blocks/s: reused %.0f, new %.0f",
+                prh / secs, prm / secs);
       mesa_logi("GPROF render pass merge candidates/s: same targets+load %.0f, "
                 "no batch between %.0f, no barrier between %.0f",
                 rm[0] / secs, rm[1] / secs, rm[2] / secs);
@@ -606,7 +627,7 @@ panvk_diag_note_atom(uint64_t atom, const char *kind,
    if (panvk_gprof_on() || hist_on) {
       simple_mtx_lock(&panvk_diag_hist_lock);
       struct panvk_diag_hist *h = &panvk_diag_hist[panvk_diag_hist_n++ & 127];
-      h->submit_ns = os_time_get_nano();
+      h->submit_ns = panvk_diag_now_ns();
       h->done_ns = 0;
       h->atom = atom & 255;
       panvk_diag_rec_fill(&h->rec, kind, batch);
@@ -1025,6 +1046,9 @@ panvk_per_arch(gpu_queue_submit)(struct vk_queue *vk_queue, struct vk_queue_subm
          return result;
    }
 
+   /* jm-v7 125: one JOB_SUBMIT for all the atoms below. */
+   kbase_kmod_jm_defer_begin(dev->kmod.dev);
+
    for (uint32_t j = 0; j < submit->command_buffer_count; ++j) {
       struct panvk_cmd_buffer *cmdbuf =
          container_of(submit->command_buffers[j], struct panvk_cmd_buffer, vk);
@@ -1079,6 +1103,8 @@ panvk_per_arch(gpu_queue_submit)(struct vk_queue *vk_queue, struct vk_queue_subm
       }
    }
 
+   kbase_kmod_jm_defer_end(dev->kmod.dev);
+
 
    if (queue->in_dep) {
       if (ntargets < PANVK_KBASE_SYNC_TARGET_COUNT)
