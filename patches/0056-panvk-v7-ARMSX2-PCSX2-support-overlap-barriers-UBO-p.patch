+/* jm-v7 105: dynamic uniform buffer words a vertex or fragment shader reads
+ * at constant offsets go to its push uniforms (FAU) instead of per-thread
+ * UBO loads, as the vendor driver and the gallium driver do. The words are
+ * read from the buffer's memory when the draw is recorded, so this is on by
+ * default only for PCSX2-based emulators, which write their constants into
+ * a mapped stream buffer before every draw; PANVK_V7_PUSH_UBO=1/0 turns it
+ * on/off everywhere (changes the compiled shaders).
+ */
+#include "util/u_process.h"
+static inline bool
+panvk_v7_knob_push_ubo(void)
+{
+   static int v = -1;
+   if (v < 0) {
+      const char *e = getenv("PANVK_V7_PUSH_UBO");
+      if (e && e[0]) {
+         v = e[0] != '0';
+      } else {
+         const char *name = util_get_process_name();
+         v = name && (strstr(name, "armsx2") || strstr(name, "pcsx2") ||
+                      strstr(name, "PCSX2") || strstr(name, "aethersx2") ||
+                      strstr(name, "nethersx2"));
+      }
+   }
+   return v;
+}
