+/* GPU profile: who waits. The first caller outside this driver (and
+ * libvulkan.so) of each CPU wait, by object and symbol, with the time spent.
+ * panvk_kbase_wait_sites_report() logs and clears them. */
+#include <dlfcn.h>
+#include <unwind.h>
+
+struct wait_site {
+   char name[112];
+   uint64_t ns, n;
+};
+static struct wait_site wait_sites[64];
+static unsigned wait_site_count;
+static simple_mtx_t wait_sites_lock = SIMPLE_MTX_INITIALIZER;
+
+struct wait_bt {
+   uintptr_t pc[16];
+   unsigned n;
+};
+
+static _Unwind_Reason_Code
+wait_bt_cb(struct _Unwind_Context *ctx, void *arg)
+{
+   struct wait_bt *bt = arg;
+   if (bt->n >= ARRAY_SIZE(bt->pc))
+      return _URC_END_OF_STACK;
+   bt->pc[bt->n++] = _Unwind_GetIP(ctx);
+   return _URC_NO_REASON;
+}
+
+static void
+wait_site_note(uint64_t ns)
+{
+   struct wait_bt bt = {0};
+   _Unwind_Backtrace(wait_bt_cb, &bt);
+
+   char name[112] = "?";
+   for (unsigned i = 0; i < bt.n; i++) {
+      Dl_info info;
+      if (!bt.pc[i] || !dladdr((void *)bt.pc[i], &info) || !info.dli_fname)
+         continue;
+      const char *base = strrchr(info.dli_fname, '/');
+      base = base ? base + 1 : info.dli_fname;
+      if (strstr(base, "vulkan_panfrost") || strstr(base, "vulkan_freedreno") ||
+          !strcmp(base, "libvulkan.so") || strstr(base, "libadrenotools"))
+         continue;
+      snprintf(name, sizeof(name), "%s:%s+0x%lx", base,
+               info.dli_sname ? info.dli_sname : "?",
+               (unsigned long)(bt.pc[i] - (uintptr_t)(info.dli_saddr
+                                                         ? info.dli_saddr
+                                                         : info.dli_fbase)));
+      break;
+   }
+
+   simple_mtx_lock(&wait_sites_lock);
+   unsigned k;
+   for (k = 0; k < wait_site_count; k++)
+      if (!strcmp(wait_sites[k].name, name))
+         break;
+   if (k == wait_site_count && wait_site_count < ARRAY_SIZE(wait_sites)) {
+      snprintf(wait_sites[k].name, sizeof(wait_sites[k].name), "%s", name);
+      wait_sites[k].ns = wait_sites[k].n = 0;
+      wait_site_count++;
+   }
+   if (k < wait_site_count) {
+      wait_sites[k].ns += ns;
+      wait_sites[k].n++;
+   }
+   simple_mtx_unlock(&wait_sites_lock);
+}
+
+void panvk_kbase_wait_sites_report(double secs);
+void
+panvk_kbase_wait_sites_report(double secs)
+{
+   simple_mtx_lock(&wait_sites_lock);
+   for (unsigned r = 0; r < 8; r++) {
+      int best = -1;
+      for (unsigned i = 0; i < wait_site_count; i++)
+         if (wait_sites[i].n && (best < 0 || wait_sites[i].ns > wait_sites[best].ns))
+            best = i;
+      if (best < 0)
+         break;
+      mesa_logi("GPROF wait %6.1f ms/s %5.1f/s avg %.2f ms  %s",
+                wait_sites[best].ns / 1e6 / secs, wait_sites[best].n / secs,
+                wait_sites[best].ns / 1e6 / wait_sites[best].n,
+                wait_sites[best].name);
+      wait_sites[best].n = 0;
+   }
+   wait_site_count = 0;
+   simple_mtx_unlock(&wait_sites_lock);
+}
