+/* A by-region dependency between fragment work of the current render pass,
+ * whose second scope only reads or writes attachments through the tile:
+ * colour/depth/stencil attachment access and input attachment reads, which
+ * read the tile buffer on v6/v7 (panvk_nir_lower_input_attachment_loads()).
+ * The data never leaves the tile, and the tile accesses of a pixel are
+ * ordered, so the pass does not need to end. Sampled or storage reads of an
+ * attachment go to memory and still split it. */
+static bool
+panvk_dependency_is_tile_local(const VkDependencyInfo *d)
+{
+   const VkPipelineStageFlags2 frag =
+      VK_PIPELINE_STAGE_2_EARLY_FRAGMENT_TESTS_BIT |
+      VK_PIPELINE_STAGE_2_LATE_FRAGMENT_TESTS_BIT |
+      VK_PIPELINE_STAGE_2_COLOR_ATTACHMENT_OUTPUT_BIT;
+   const VkPipelineStageFlags2 frag_dst =
+      frag | VK_PIPELINE_STAGE_2_FRAGMENT_SHADER_BIT;
+   const VkAccessFlags2 tile_access =
+      VK_ACCESS_2_INPUT_ATTACHMENT_READ_BIT |
+      VK_ACCESS_2_COLOR_ATTACHMENT_READ_BIT |
+      VK_ACCESS_2_COLOR_ATTACHMENT_WRITE_BIT |
+      VK_ACCESS_2_DEPTH_STENCIL_ATTACHMENT_READ_BIT |
+      VK_ACCESS_2_DEPTH_STENCIL_ATTACHMENT_WRITE_BIT;
+
+   if (!(d->dependencyFlags & VK_DEPENDENCY_BY_REGION_BIT) ||
+       d->bufferMemoryBarrierCount ||
+       !(d->memoryBarrierCount + d->imageMemoryBarrierCount))
+      return false;
+
+   for (uint32_t i = 0; i < d->memoryBarrierCount; i++) {
+      const VkMemoryBarrier2 *b = &d->pMemoryBarriers[i];
+      if ((b->srcStageMask & ~frag) || (b->dstStageMask & ~frag_dst) ||
+          (b->dstAccessMask & ~tile_access))
+         return false;
+   }
+   for (uint32_t i = 0; i < d->imageMemoryBarrierCount; i++) {
+      const VkImageMemoryBarrier2 *b = &d->pImageMemoryBarriers[i];
+      if (b->oldLayout != b->newLayout ||
+          b->srcQueueFamilyIndex != b->dstQueueFamilyIndex ||
+          (b->srcStageMask & ~frag) || (b->dstStageMask & ~frag_dst) ||
+          (b->dstAccessMask & ~tile_access))
+         return false;
+   }
+   return true;
+}
+
+/* Overlap (PANVK_OVERLAP) runs a batch's vertex/tiler chain during the
+ * previous batch's fragment job. A dependency from work that can run in a
+ * fragment job (fragment stages, attachment output, and clears/copies done
+ * as draws) to work that runs in the vertex/tiler chain (vertex input and
+ * shaders, tessellation and geometry emulation, indirect arguments, compute,
+ * copies done as dispatches) must not overlap: the next batch waits for the
+ * fragment job (after_frag). Synchronization CTS: fragment writes read by
+ * the tessellation/geometry emulation.
+ */
+static bool
+panvk_dependency_needs_frag_done(const VkDependencyInfo *dep)
+{
+   const VkPipelineStageFlags2 frag_src =
+      VK_PIPELINE_STAGE_2_FRAGMENT_SHADER_BIT |
+      VK_PIPELINE_STAGE_2_EARLY_FRAGMENT_TESTS_BIT |
+      VK_PIPELINE_STAGE_2_LATE_FRAGMENT_TESTS_BIT |
+      VK_PIPELINE_STAGE_2_COLOR_ATTACHMENT_OUTPUT_BIT |
+      VK_PIPELINE_STAGE_2_ALL_GRAPHICS_BIT |
+      VK_PIPELINE_STAGE_2_ALL_COMMANDS_BIT |
+      VK_PIPELINE_STAGE_2_BOTTOM_OF_PIPE_BIT |
+      VK_PIPELINE_STAGE_2_ALL_TRANSFER_BIT | VK_PIPELINE_STAGE_2_COPY_BIT |
+      VK_PIPELINE_STAGE_2_BLIT_BIT | VK_PIPELINE_STAGE_2_CLEAR_BIT |
+      VK_PIPELINE_STAGE_2_RESOLVE_BIT;
+   const VkPipelineStageFlags2 vtc_dst =
+      VK_PIPELINE_STAGE_2_TOP_OF_PIPE_BIT |
+      VK_PIPELINE_STAGE_2_DRAW_INDIRECT_BIT |
+      VK_PIPELINE_STAGE_2_VERTEX_INPUT_BIT |
+      VK_PIPELINE_STAGE_2_INDEX_INPUT_BIT |
+      VK_PIPELINE_STAGE_2_VERTEX_ATTRIBUTE_INPUT_BIT |
+      VK_PIPELINE_STAGE_2_VERTEX_SHADER_BIT |
+      VK_PIPELINE_STAGE_2_TESSELLATION_CONTROL_SHADER_BIT |
+      VK_PIPELINE_STAGE_2_TESSELLATION_EVALUATION_SHADER_BIT |
+      VK_PIPELINE_STAGE_2_GEOMETRY_SHADER_BIT |
+      VK_PIPELINE_STAGE_2_PRE_RASTERIZATION_SHADERS_BIT |
+      VK_PIPELINE_STAGE_2_TRANSFORM_FEEDBACK_BIT_EXT |
+      VK_PIPELINE_STAGE_2_COMPUTE_SHADER_BIT |
+      VK_PIPELINE_STAGE_2_ALL_GRAPHICS_BIT |
+      VK_PIPELINE_STAGE_2_ALL_COMMANDS_BIT |
+      VK_PIPELINE_STAGE_2_ALL_TRANSFER_BIT | VK_PIPELINE_STAGE_2_COPY_BIT |
+      VK_PIPELINE_STAGE_2_BLIT_BIT | VK_PIPELINE_STAGE_2_CLEAR_BIT |
+      VK_PIPELINE_STAGE_2_RESOLVE_BIT;
+   VkPipelineStageFlags2 src = 0, dst = 0;
+   for (uint32_t i = 0; i < dep->memoryBarrierCount; i++) {
+      src |= dep->pMemoryBarriers[i].srcStageMask;
+      dst |= dep->pMemoryBarriers[i].dstStageMask;
+   }
+   for (uint32_t i = 0; i < dep->bufferMemoryBarrierCount; i++) {
+      src |= dep->pBufferMemoryBarriers[i].srcStageMask;
+      dst |= dep->pBufferMemoryBarriers[i].dstStageMask;
+   }
+   for (uint32_t i = 0; i < dep->imageMemoryBarrierCount; i++) {
+      src |= dep->pImageMemoryBarriers[i].srcStageMask;
+      dst |= dep->pImageMemoryBarriers[i].dstStageMask;
+   }
+   return (src & frag_src) && (dst & vtc_dst);
+}
+
 VKAPI_ATTR void VKAPI_CALL
 panvk_per_arch(CmdPipelineBarrier2)(VkCommandBuffer commandBuffer,
                                     const VkDependencyInfo *pDependencyInfo)
@@ -774,6 +960,48 @@ panvk_per_arch(CmdPipelineBarrier2)(VkCommandBuffer commandBuffer,
       return;
    }
 
+   /* Emulators that read the render target back per draw (PCSX2/ARMSX2's
+    * ColorBufferBarrier, PS2 blending) record one such barrier per draw:
+    * each split stored and reloaded every tile of the pass. Kingdom
+    * Hearts in ARMSX2: ~860 splits/s, 5-8 FPS.
+    * PANVK_SPLIT_TILE_BARRIERS=1 restores the split. */
+   static int split_tile = -1;
+   if (split_tile < 0) {
+      const char *e = getenv("PANVK_SPLIT_TILE_BARRIERS");
+      split_tile = e && e[0] == '1';
+   }
+   if (!split_tile && cmdbuf->cur_batch && cmdbuf->state.gfx.render.active &&
+       panvk_dependency_is_tile_local(pDependencyInfo)) {
+      p_atomic_inc(&panvk_mem_stats.batch_why[5]);
+      return;
+   }
+   if (cmdbuf->state.gfx.render.active && getenv("PANVK_LOG_PASS_BARRIERS")) {
+      static int logged;
+      if (logged < 16) {
+         logged++;
+         const VkDependencyInfo *d = pDependencyInfo;
+         mesa_logi("panvk: in-pass barrier splits: flags 0x%x mem %u buf %u img %u",
+                   d->dependencyFlags, d->memoryBarrierCount,
+                   d->bufferMemoryBarrierCount, d->imageMemoryBarrierCount);
+         for (uint32_t i = 0; i < d->memoryBarrierCount; i++)
+            mesa_logi("panvk:   mem src 0x%" PRIx64 "/0x%" PRIx64
+                      " dst 0x%" PRIx64 "/0x%" PRIx64,
+                      d->pMemoryBarriers[i].srcStageMask,
+                      d->pMemoryBarriers[i].srcAccessMask,
+                      d->pMemoryBarriers[i].dstStageMask,
+                      d->pMemoryBarriers[i].dstAccessMask);
+         for (uint32_t i = 0; i < d->imageMemoryBarrierCount; i++)
+            mesa_logi("panvk:   img src 0x%" PRIx64 "/0x%" PRIx64
+                      " dst 0x%" PRIx64 "/0x%" PRIx64 " layout %d->%d",
+                      d->pImageMemoryBarriers[i].srcStageMask,
+                      d->pImageMemoryBarriers[i].srcAccessMask,
+                      d->pImageMemoryBarriers[i].dstStageMask,
+                      d->pImageMemoryBarriers[i].dstAccessMask,
+                      d->pImageMemoryBarriers[i].oldLayout,
+                      d->pImageMemoryBarriers[i].newLayout);
+      }
+   }
+
    /* Caches are flushed/invalidated at batch boundaries for now, nothing to do
     * for memory barriers assuming we implement barriers with the creation of a
     * new batch.
@@ -787,6 +1015,13 @@ panvk_per_arch(CmdPipelineBarrier2)(VkCommandBuffer commandBuffer,
       panvk_per_arch(cmd_open_batch)(cmdbuf);
    }
 
+   if (panvk_dependency_needs_frag_done(pDependencyInfo)) {
+      if (cmdbuf->cur_batch)
+         cmdbuf->cur_batch->after_frag = true;
+      else
+         cmdbuf->next_batch_after_frag = true;
+   }
+
    /* BC emulation: an image leaving VK_IMAGE_LAYOUT_ZERO_INITIALIZED_EXT
     * has zero blocks, whose decoded texels are not zero (BC1 decodes them
     * to opaque black). Decode them as CSF does. The internal barriers it
@@ -803,6 +1038,7 @@ panvk_reset_cmdbuf(struct vk_command_buffer *vk_cmdbuf,
       container_of(vk_cmdbuf, struct panvk_cmd_buffer, vk);
 
    vk_command_buffer_reset(&cmdbuf->vk);
+   cmdbuf->next_batch_after_frag = false;
 
    list_for_each_entry_safe(struct panvk_batch, batch, &cmdbuf->batches, node) {
       list_del(&batch->node);
