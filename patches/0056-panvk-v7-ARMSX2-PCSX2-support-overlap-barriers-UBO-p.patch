    batch->hoist_jc = (struct pan_jc){0};
 }
 
+/* PANVK_GPU_TS=1: a WRITE_VALUE job of the GPU system timestamp at the head
+ * of every vertex/tiler chain and one with a barrier at its end, into an
+ * uncached ring of the device, for the GPU profile (PANVK_GPU_PROF): the
+ * GPU's own time of the chain, where the completion events the profile
+ * otherwise uses are noticed by the CPU late. Diagnostics only.
+ */
+#define PANVK_GTS_SLOTS 4096
+static struct panvk_priv_bo *panvk_gts_bo;
+static unsigned panvk_gts_next;
+
+bool
+panvk_per_arch(gts_on)(void)
+{
+   static int v = -1;
+   if (v < 0) {
+      const char *e = getenv("PANVK_GPU_TS");
+      v = e && e[0] == '1';
+   }
+   return v;
+}
+
+const volatile uint64_t *
+panvk_per_arch(gts_host)(unsigned slot)
+{
+   if (!slot || !panvk_gts_bo)
+      return NULL;
+   return (const volatile uint64_t *)panvk_gts_bo->addr.host +
+          2 * ((slot - 1) % PANVK_GTS_SLOTS);
+}
+
+static void
+emit_gts(struct panvk_cmd_buffer *cmdbuf, struct panvk_batch *batch)
+{
+   struct panvk_device *dev = to_panvk_device(cmdbuf->vk.base.device);
+   if (!panvk_gts_bo &&
+       panvk_priv_bo_create(dev, PANVK_GTS_SLOTS * 16, 0,
+                            VK_SYSTEM_ALLOCATION_SCOPE_DEVICE,
+                            &panvk_gts_bo) != VK_SUCCESS)
+      return;
+   if (!panvk_gts_bo->addr.host)
+      return;
+
+   const unsigned slot = p_atomic_inc_return(&panvk_gts_next) % PANVK_GTS_SLOTS;
+   const uint64_t addr = panvk_gts_bo->addr.dev + slot * 16;
+
+   struct pan_ptr start =
+      pan_pool_alloc_desc(&cmdbuf->desc_pool.base, WRITE_VALUE_JOB);
+   struct pan_ptr end =
+      pan_pool_alloc_desc(&cmdbuf->desc_pool.base, WRITE_VALUE_JOB);
+   if (!start.gpu || !end.gpu)
+      return;
+
+   pan_section_pack(start.cpu, WRITE_VALUE_JOB, PAYLOAD, payload) {
+      payload.type = MALI_WRITE_VALUE_TYPE_SYSTEM_TIMESTAMP;
+      payload.address = addr;
+   };
+   pan_cast_and_pack(start.cpu, JOB_HEADER, header) {
+      header.type = MALI_JOB_TYPE_WRITE_VALUE;
+      header.index = ++batch->vtc_jc.job_index;
+      header.next = batch->vtc_jc.first_job;
+   }
+   batch->vtc_jc.first_job = start.gpu;
+   util_dynarray_append(&batch->jobs, start.cpu);
+
+   pan_section_pack(end.cpu, WRITE_VALUE_JOB, PAYLOAD, payload) {
+      payload.type = MALI_WRITE_VALUE_TYPE_SYSTEM_TIMESTAMP;
+      payload.address = addr + 8;
+   };
+   pan_jc_add_job(&batch->vtc_jc, MALI_JOB_TYPE_WRITE_VALUE, true, false, 0, 0,
+                  &end, false);
+   util_dynarray_append(&batch->jobs, end.cpu);
+
+   batch->gts_slot = slot + 1;
+}
