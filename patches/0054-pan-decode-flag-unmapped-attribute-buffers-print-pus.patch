From 140f694ccd7d9020a7b87de15fa023997c8d5315 Mon Sep 17 00:00:00 2001
From: soulexit <metehan.tanriverdi01@gmail.com>
Date: Thu, 29 Oct 2026 22:56:13 +0300
Subject: [PATCH 54/54] pan/decode: flag unmapped attribute buffers, print push
 uniforms

Attribute (storage image) buffers outside every known mapping or running
past theirs are flagged, and push uniform words are printed with
unmapped address-like values marked: what found the copy source overrun
in NieR:Automata's job dump.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/panfrost/genxml/decode_jm.c | 30 ++++++++++++++++++++++++++++++
 1 file changed, 30 insertions(+)

diff --git a/src/panfrost/genxml/decode_jm.c b/src/panfrost/genxml/decode_jm.c
index f01891b..38d04b5 100644
--- a/src/panfrost/genxml/decode_jm.c
+++ b/src/panfrost/genxml/decode_jm.c
@@ -61,6 +61,23 @@ pandecode_attributes(struct pandecode_context *ctx, uint64_t addr, int count,
       pan_unpack(&cl[i], ATTRIBUTE_BUFFER, temp);
       DUMP_UNPACKED(ctx, ATTRIBUTE_BUFFER, temp, "%s:\n", prefix);
 
+      /* Flag buffers outside every known mapping, or running past the end
+       * of theirs: the GPU faults on them. */
+      if (temp.pointer && temp.size) {
+         struct pandecode_mapped_memory *m =
+            pandecode_find_mapped_gpu_mem_containing(ctx, temp.pointer);
+         if (!m)
+            pandecode_log(ctx, "// XXX: %s 0x%" PRIx64 " is not mapped\n",
+                          prefix, (uint64_t)temp.pointer);
+         else if (temp.pointer + temp.size > m->gpu_va + m->length)
+            pandecode_log(ctx,
+                          "// XXX: %s 0x%" PRIx64 "+0x%" PRIx64 " runs 0x%" PRIx64
+                          " bytes past its mapping 0x%" PRIx64 "+0x%zx\n",
+                          prefix, (uint64_t)temp.pointer, (uint64_t)temp.size,
+                          temp.pointer + temp.size - (m->gpu_va + m->length),
+                          m->gpu_va, m->length);
+      }
+
       switch (temp.type) {
       case MALI_ATTRIBUTE_TYPE_1D_NPOT_DIVISOR_WRITE_REDUCTION:
       case MALI_ATTRIBUTE_TYPE_1D_NPOT_DIVISOR: {
@@ -233,6 +250,19 @@ pandecode_uniforms(struct pandecode_context *ctx, uint64_t uniforms,
    char *ptr = pointer_as_memory_reference(ctx, uniforms);
    pandecode_log(ctx, "vec4 uniforms[%u] = %s;\n", uniform_count, ptr);
    free(ptr);
+
+   /* The values, as 64-bit words: sysvals hold descriptor set and table
+    * addresses, flagged when they look like GPU addresses outside every
+    * known mapping. */
+   const uint64_t *u = pandecode_fetch_gpu_mem(ctx, uniforms, uniform_count * 16);
+   for (unsigned i = 0; i < uniform_count * 2; i++) {
+      const uint64_t v = u[i];
+      const bool addr_like = v >= (1ull << 32) && v < (1ull << 40);
+      const char *note = "";
+      if (addr_like && !pandecode_find_mapped_gpu_mem_containing(ctx, v))
+         note = "  // XXX: not mapped";
+      pandecode_log(ctx, "  u64[%2u] = 0x%016" PRIx64 "%s\n", i, v, note);
+   }
    pandecode_log(ctx, "\n");
 }
 
