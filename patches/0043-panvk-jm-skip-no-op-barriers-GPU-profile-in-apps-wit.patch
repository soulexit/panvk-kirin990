-   if (!f)
-      return;
+   if (!f) {
+      /* Apps without storage permission (Eden) can always read their own
+       * external files directory: /sdcard/Android/data/<package>/files. */
+      char pkg[128] = "", path[256];
+      FILE *c = fopen("/proc/self/cmdline", "r");
+      if (c) {
+         if (!fgets(pkg, sizeof(pkg), c))
+            pkg[0] = 0;
+         fclose(c);
+      }
+      pkg[strcspn(pkg, ":")] = 0;
+      if (!pkg[0])
+         return;
+      snprintf(path, sizeof(path), "/sdcard/Android/data/%s/files/panvk_env.txt",
+               pkg);
+      f = fopen(path, "r");
+      if (!f)
+         return;
+   }
    char line[256];
    while (fgets(line, sizeof(line), f)) {
       line[strcspn(line, "\r\n")] = 0;
diff --git a/src/panfrost/vulkan/panvk_priv_bo.h b/src/panfrost/vulkan/panvk_priv_bo.h
