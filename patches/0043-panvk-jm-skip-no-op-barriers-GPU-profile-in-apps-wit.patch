diff --git a/src/panfrost/vulkan/jm/panvk_vX_cmd_buffer.c b/src/panfrost/vulkan/jm/panvk_vX_cmd_buffer.c
index bb6914d..8799e2a 100644
--- a/src/panfrost/vulkan/jm/panvk_vX_cmd_buffer.c
+++ b/src/panfrost/vulkan/jm/panvk_vX_cmd_buffer.c
@@ -720,18 +720,68 @@ panvk_per_arch(EndCommandBuffer)(VkCommandBuffer commandBuffer)
    return vk_command_buffer_end(&cmdbuf->vk);
 }
 
+/* A barrier half whose second scope is only TOP_OF_PIPE (or nothing), or
+ * whose first scope is only BOTTOM_OF_PIPE (or nothing), orders nothing and
+ * makes nothing visible. */
+static bool
+panvk_barrier_stages_noop(VkPipelineStageFlags2 src, VkPipelineStageFlags2 dst)
+{
+   return !(dst & ~VK_PIPELINE_STAGE_2_TOP_OF_PIPE_BIT) ||
+          !(src & ~VK_PIPELINE_STAGE_2_BOTTOM_OF_PIPE_BIT);
+}
+
+static bool
+panvk_dependency_is_noop(const VkDependencyInfo *d)
+{
+   for (uint32_t i = 0; i < d->memoryBarrierCount; i++) {
+      const VkMemoryBarrier2 *b = &d->pMemoryBarriers[i];
+      if (!panvk_barrier_stages_noop(b->srcStageMask, b->dstStageMask))
+         return false;
+   }
+   for (uint32_t i = 0; i < d->bufferMemoryBarrierCount; i++) {
+      const VkBufferMemoryBarrier2 *b = &d->pBufferMemoryBarriers[i];
+      if (b->srcQueueFamilyIndex != b->dstQueueFamilyIndex ||
+          !panvk_barrier_stages_noop(b->srcStageMask, b->dstStageMask))
+         return false;
+   }
+   for (uint32_t i = 0; i < d->imageMemoryBarrierCount; i++) {
+      const VkImageMemoryBarrier2 *b = &d->pImageMemoryBarriers[i];
+      if (b->oldLayout != b->newLayout ||
+          b->srcQueueFamilyIndex != b->dstQueueFamilyIndex ||
+          !panvk_barrier_stages_noop(b->srcStageMask, b->dstStageMask))
+         return false;
+   }
+   return true;
+}
+
 VKAPI_ATTR void VKAPI_CALL
 panvk_per_arch(CmdPipelineBarrier2)(VkCommandBuffer commandBuffer,
                                     const VkDependencyInfo *pDependencyInfo)
 {
    VK_FROM_HANDLE(panvk_cmd_buffer, cmdbuf, commandBuffer);
 
+   /* Yuzu-based emulators (Eden) record ~40 barriers per frame inside
+    * render passes from every stage to TOP_OF_PIPE with no access: no-ops,
+    * but each split the batch, so the pass's tiles were stored and loaded
+    * again. PANVK_SPLIT_NOOP_BARRIERS=1 restores the split. */
+   static int split_noop = -1;
+   if (split_noop < 0) {
+      const char *e = getenv("PANVK_SPLIT_NOOP_BARRIERS");
+      split_noop = e && e[0] == '1';
+   }
+   if (!split_noop && panvk_dependency_is_noop(pDependencyInfo)) {
+      p_atomic_inc(&panvk_mem_stats.batch_why[4]);
+      return;
+   }
+
    /* Caches are flushed/invalidated at batch boundaries for now, nothing to do
     * for memory barriers assuming we implement barriers with the creation of a
     * new batch.
     * FIXME: We can probably do better with a CacheFlush job that has the
     * barrier flag set to true.
     */
+   p_atomic_inc(&panvk_mem_stats.batch_why[cmdbuf->cur_batch ? 1 : 2]);
+
    if (cmdbuf->cur_batch) {
       panvk_per_arch(cmd_close_batch)(cmdbuf);
       panvk_per_arch(cmd_open_batch)(cmdbuf);
