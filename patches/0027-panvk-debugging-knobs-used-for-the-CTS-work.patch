From 2b001a2bfde25e4f8844b3e74fdc1bd4c2394055 Mon Sep 17 00:00:00 2001
From: soulexit <metehan.tanriverdi01@gmail.com>
Date: Mon, 26 Oct 2026 08:21:28 +0300
Subject: [PATCH 27/27] panvk: debugging knobs used for the CTS work

PANVK_NO_LWG=1 disables the large-workgroup split, PANVK_TRACE_JC=1 with
PANVK_DEBUG=trace decodes each JM job chain after it ran (the call was
stubbed out), PANVK_IMPORT_LOG=1 logs kbase dma-buf import flags at info
level.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/panfrost/lib/kmod/kbase_kmod.c          | 2 +-
 src/panfrost/vulkan/jm/panvk_vX_gpu_queue.c | 6 +++---
 src/panfrost/vulkan/panvk_vX_shader.c       | 2 +-
 3 files changed, 5 insertions(+), 5 deletions(-)

diff --git a/src/panfrost/lib/kmod/kbase_kmod.c b/src/panfrost/lib/kmod/kbase_kmod.c
index beb29e6..70f515c 100644
--- a/src/panfrost/lib/kmod/kbase_kmod.c
+++ b/src/panfrost/lib/kmod/kbase_kmod.c
@@ -2579,7 +2579,7 @@ kbase_kmod_import_dmabuf(struct pan_kmod_dev *dev,
       simple_mtx_unlock(&kbase_dev->nc_lock);
    }
    mesa_log(MESA_LOG_DEBUG, MESA_LOG_TAG, "kbase_kmod_bo_alloc_dmabuf: succeeded for %d, bo_size=%lu, handle=%u", kbase_bo->dmabuf_fd, bo_size, handle);
-   mesa_log(MESA_LOG_DEBUG, MESA_LOG_TAG, "kbase: import flags=0x%llx -> va=0x%llx pages=%llu outflags=0x%llx",
+   mesa_log(getenv("PANVK_IMPORT_LOG") ? MESA_LOG_INFO : MESA_LOG_DEBUG, MESA_LOG_TAG, "kbase: import flags=0x%llx -> va=0x%llx pages=%llu outflags=0x%llx",
              (unsigned long long)import_flags,
              (unsigned long long)req.out.gpu_va,
              (unsigned long long)req.out.va_pages,
diff --git a/src/panfrost/vulkan/jm/panvk_vX_gpu_queue.c b/src/panfrost/vulkan/jm/panvk_vX_gpu_queue.c
index c092bd4..b9006e8 100644
--- a/src/panfrost/vulkan/jm/panvk_vX_gpu_queue.c
+++ b/src/panfrost/vulkan/jm/panvk_vX_gpu_queue.c
@@ -417,9 +417,9 @@ panvk_queue_submit_batch(struct panvk_gpu_queue *queue,
          pan_kmod_flush_bo_map_syncs(dev->kmod.dev);
       }
 
-      if (PANVK_DEBUG(TRACE)) {
-         /* skip pandecode_jc */
-      }
+      if (PANVK_DEBUG(TRACE) && getenv("PANVK_TRACE_JC"))
+         pandecode_jc(dev->debug.decode_ctx, batch->vtc_jc.first_job,
+                      phys_dev->kmod.dev->props.gpu_id);
 
       if (PANVK_DEBUG(DUMP))
          pandecode_dump_mappings(dev->debug.decode_ctx);
diff --git a/src/panfrost/vulkan/panvk_vX_shader.c b/src/panfrost/vulkan/panvk_vX_shader.c
index b12c32c..f146d68 100644
--- a/src/panfrost/vulkan/panvk_vX_shader.c
+++ b/src/panfrost/vulkan/panvk_vX_shader.c
@@ -832,7 +832,7 @@ panvk_lower_large_workgroup(nir_shader *nir, unsigned max_hw)
                               nir->info.workgroup_size[1],
                               nir->info.workgroup_size[2]};
    const unsigned n = lsize[0] * lsize[1] * lsize[2];
-   if (n <= max_hw)
+   if (n <= max_hw || getenv("PANVK_NO_LWG"))
       return false;
 
    unsigned k = DIV_ROUND_UP(n, max_hw);
-- 
