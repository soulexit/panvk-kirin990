From e19d64a3fca5e2859f5129c341b410db0778be2e Mon Sep 17 00:00:00 2001
From: soulexit <metehan.tanriverdi01@gmail.com>
Date: Thu, 29 Oct 2026 20:46:03 +0300
Subject: [PATCH 51/54] panvk/jm: GPU profile counts indexed draws and
 describes the render pass

Batch kinds only counted non-indexed draws and their framebuffer, so a
pass of indexed draws showed as "draws 0 fb=0x0". Count every draw and
add the render area, colour attachments, depth/stencil and load ops to
the kind signature.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/panfrost/vulkan/jm/panvk_cmd_buffer.h   |  3 +++
 src/panfrost/vulkan/jm/panvk_vX_cmd_draw.c  | 28 +++++++++++++++++++++
 src/panfrost/vulkan/jm/panvk_vX_gpu_queue.c | 10 +++++---
 3 files changed, 38 insertions(+), 3 deletions(-)

diff --git a/src/panfrost/vulkan/jm/panvk_cmd_buffer.h b/src/panfrost/vulkan/jm/panvk_cmd_buffer.h
index 2401b4c..5b80c1d 100644
--- a/src/panfrost/vulkan/jm/panvk_cmd_buffer.h
+++ b/src/panfrost/vulkan/jm/panvk_cmd_buffer.h
@@ -110,6 +110,9 @@ struct panvk_batch {
       uint32_t precomp_n;
       bool indirect;
       uint64_t max_verts;
+      /* Render pass: render area, samples, colour attachments, depth or
+       * stencil, colour attachments loaded (bitmask), depth/stencil load. */
+      uint32_t rp_w, rp_h, rp_samples, rp_colors, rp_zs, rp_load, rp_zsload;
    } diag;
 };
 
diff --git a/src/panfrost/vulkan/jm/panvk_vX_cmd_draw.c b/src/panfrost/vulkan/jm/panvk_vX_cmd_draw.c
index 1c914af..10b0356 100644
--- a/src/panfrost/vulkan/jm/panvk_vX_cmd_draw.c
+++ b/src/panfrost/vulkan/jm/panvk_vX_cmd_draw.c
@@ -3319,6 +3319,8 @@ panvk_cmd_draw_indirect(struct panvk_cmd_buffer *cmdbuf,
    if (result != VK_SUCCESS)
       return;
 
+   cmdbuf->cur_batch->diag.draws++;
+
    struct panvk_batch *batch = cmdbuf->cur_batch;
    const struct vk_vertex_input_state *vi =
       cmdbuf->vk.dynamic_graphics_state.vi;
@@ -7641,6 +7643,32 @@ panvk_per_arch(CmdBeginRendering)(VkCommandBuffer commandBuffer,
 
    if (!cmdbuf->cur_batch)
       panvk_per_arch(cmd_open_batch)(cmdbuf);
+
+   {
+      struct panvk_batch *b = cmdbuf->cur_batch;
+      const VkRenderingAttachmentInfo *zs =
+         pRenderingInfo->pDepthAttachment &&
+               pRenderingInfo->pDepthAttachment->imageView
+            ? pRenderingInfo->pDepthAttachment
+            : pRenderingInfo->pStencilAttachment;
+      b->diag.rp_w = pRenderingInfo->renderArea.extent.width;
+      b->diag.rp_h = pRenderingInfo->renderArea.extent.height;
+      b->diag.rp_samples = state->render.fb.layout.sample_count;
+      b->diag.rp_colors = 0;
+      b->diag.rp_load = 0;
+      for (uint32_t i = 0; i < pRenderingInfo->colorAttachmentCount; i++) {
+         const VkRenderingAttachmentInfo *a =
+            &pRenderingInfo->pColorAttachments[i];
+         if (!a->imageView)
+            continue;
+         b->diag.rp_colors++;
+         if (a->loadOp == VK_ATTACHMENT_LOAD_OP_LOAD)
+            b->diag.rp_load |= 1u << i;
+      }
+      b->diag.rp_zs = zs && zs->imageView;
+      b->diag.rp_zsload =
+         b->diag.rp_zs && zs->loadOp == VK_ATTACHMENT_LOAD_OP_LOAD;
+   }
 }
 
 VKAPI_ATTR void VKAPI_CALL
diff --git a/src/panfrost/vulkan/jm/panvk_vX_gpu_queue.c b/src/panfrost/vulkan/jm/panvk_vX_gpu_queue.c
index 8757c38..d5715ef 100644
--- a/src/panfrost/vulkan/jm/panvk_vX_gpu_queue.c
+++ b/src/panfrost/vulkan/jm/panvk_vX_gpu_queue.c
@@ -223,7 +223,7 @@ panvk_diag_atom_failed(unsigned atom)
  * its submission and the previous completion.  Top kinds are logged every
  * 5 s as ms of GPU time per second. */
 struct panvk_gprof_kind {
-   char sig[128];
+   char sig[192];
    uint64_t ns, count, draws;
 };
 static struct panvk_gprof_kind panvk_gprof_kinds[1024];
@@ -382,15 +382,19 @@ static void
 panvk_gprof_submit(uint64_t atom, const char *kind,
                    const struct panvk_batch *batch)
 {
-   char sig[128];
+   char sig[192];
    Dl_info dli;
    uintptr_t op = batch->diag.opener;
    if (op && dladdr((void *)op, &dli) && dli.dli_fbase)
       op -= (uintptr_t)dli.dli_fbase;
    snprintf(sig, sizeof(sig),
-            "%s op=%lx pc=%d/%u fb=%ux%u%s%s%s cs=%08x wg=%ux%ux%u l=%ux%u",
+            "%s op=%lx pc=%d/%u fb=%ux%u rp=%ux%u s%u c%u z%u ld%x/%u%s%s%s "
+            "cs=%08x wg=%ux%ux%u l=%ux%u",
             kind, (unsigned long)op, batch->diag.precomp,
             batch->diag.precomp_n, batch->diag.fb_w, batch->diag.fb_h,
+            batch->diag.rp_w, batch->diag.rp_h, batch->diag.rp_samples,
+            batch->diag.rp_colors, batch->diag.rp_zs, batch->diag.rp_load,
+            batch->diag.rp_zsload,
             batch->diag.gs ? " gs" : "", batch->diag.tess ? " tess" : "",
             batch->diag.xfb ? " xfb" : "",
             batch->diag.dispatches ? batch->diag.cs_hash : 0,
-- 
