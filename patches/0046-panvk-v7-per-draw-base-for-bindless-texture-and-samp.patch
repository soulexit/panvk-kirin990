       uint64_t dev_addr;
@@ -81,14 +83,47 @@ VkResult panvk_per_arch(cmd_prepare_shader_desc_tables)(
    struct panvk_shader_desc_state *shader_desc_state);
 
 /* Bindless textures/samplers (jm-v7 050): the direct texture and sampler
- * tables point at a device-constant base 64 GiB below the device dummy
- * sampler, and shaders index set memory as (set - base) / 32 + descriptor
- * (desc.direct_idx sysvals). kbase maps GPU memory at its CPU address
- * (SAME_VA), so descriptor pools land within the +-64 GiB a 32-bit index
- * covers. A constant base keeps the textures pointer and the sysvals in
- * sync whatever is bound.
+ * tables point at a base, and shaders index set memory as
+ * (set - base) / 32 + descriptor (desc.direct_idx sysvals). kbase maps GPU
+ * memory at its CPU address (SAME_VA), and in Wine/FEX processes descriptor
+ * pools land hundreds of GiB apart, more than a 32-bit index covers from
+ * one device-constant base. So the base is the lowest of the dummy sampler
+ * and the bound sets, per draw or dispatch. It depends only on what is
+ * bound, so the sysvals (shared by the VS and FS) and every stage's tables
+ * agree; a stage's tables are rebuilt when it moves
+ * (panvk_shader_desc_state::direct_base).
  */
-#define PANVK_DIRECT_BASE_SPAN (64ull << 30)
+#define PANVK_DIRECT_BASE_SPAN ((uint64_t)PANVK_DESCRIPTOR_SIZE << 32)
+
+static inline uint64_t
+panvk_desc_direct_base(const struct panvk_descriptor_state *desc_state,
+                       uint64_t dummy_sampler_addr)
+{
+   uint64_t lo = dummy_sampler_addr;
+   uint64_t hi = dummy_sampler_addr + PANVK_DESCRIPTOR_SIZE;
+
+   for (uint32_t i = 0; i < MAX_SETS; i++) {
+      const struct panvk_descriptor_set *set = desc_state->sets[i];
+
+      if (!set || !set->descs.dev)
+         continue;
+      lo = MIN2(lo, set->descs.dev);
+      hi = MAX2(hi, set->descs.dev +
+                       (uint64_t)set->desc_count * PANVK_DESCRIPTOR_SIZE);
+   }
+
+   if (hi - lo > PANVK_DIRECT_BASE_SPAN) {
+      static bool warned;
+      if (!warned) {
+         warned = true;
+         mesa_logw("panvk: bound descriptor sets span %" PRIu64
+                   " GiB, more than bindless indices reach",
+                   (hi - lo) >> 30);
+      }
+   }
+
+   return lo;
+}
 
 static inline uint32_t
 panvk_desc_direct_idx(uint64_t base, uint64_t addr)
