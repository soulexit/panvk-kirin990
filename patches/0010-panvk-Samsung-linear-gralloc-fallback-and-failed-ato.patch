From 51ff0a088229376b4913b9504eb023c5771ac879 Mon Sep 17 00:00:00 2001
From: soulexit <b@l>
Date: Sun, 25 Oct 2026 11:36:58 +0300
Subject: [PATCH] panvk: Samsung linear gralloc fallback and failed-atom batch
 diagnostics

---
 src/panfrost/lib/kmod/kbase_kmod.c          |  7 ++++-
 src/panfrost/lib/kmod/kbase_kmod.h          |  1 +
 src/panfrost/vulkan/jm/panvk_cmd_buffer.h   |  5 ++++
 src/panfrost/vulkan/jm/panvk_vX_cmd_draw.c  | 16 +++++++++++
 src/panfrost/vulkan/jm/panvk_vX_gpu_queue.c | 31 +++++++++++++++++++++
 src/util/u_gralloc/u_gralloc_fallback.c     | 23 +++++++++++++++
 6 files changed, 82 insertions(+), 1 deletion(-)

diff --git a/src/panfrost/lib/kmod/kbase_kmod.c b/src/panfrost/lib/kmod/kbase_kmod.c
index 4955a4c..917d39e 100644
--- a/src/panfrost/lib/kmod/kbase_kmod.c
+++ b/src/panfrost/lib/kmod/kbase_kmod.c
@@ -2313,6 +2313,8 @@ kbase_diag_untrack(const void *bo)
    simple_mtx_unlock(&kbase_diag_lock);
 }
 
+void (*kbase_kmod_atom_fail_cb)(unsigned atom);
+
 void
 kbase_kmod_diag_sample_imports(const char *why)
 {
@@ -3251,9 +3253,12 @@ kbase_atom_process_event_locked(struct kbase_kmod_dev *kd,
          struct kbase_atom_slot *s = &kd->atoms[i];
          s->completed = true;
          s->errored = errored;
-         if (errored)
+         if (errored) {
             mesa_loge("kbase: JM atom %u failed: event=0x%x core_req=0x%x",
                       num, ev->event_code, s->core_req);
+            if (kbase_kmod_atom_fail_cb)
+               kbase_kmod_atom_fail_cb(num);
+         }
          if (s->waiters == 0)
             s->atom_number = 0;
          return;
diff --git a/src/panfrost/lib/kmod/kbase_kmod.h b/src/panfrost/lib/kmod/kbase_kmod.h
index b4d4b09..43559e9 100644
--- a/src/panfrost/lib/kmod/kbase_kmod.h
+++ b/src/panfrost/lib/kmod/kbase_kmod.h
@@ -152,6 +152,7 @@ int kbase_kmod_csf_wait_cqs64(struct pan_kmod_dev *dev, uint64_t addr,
                               int64_t timeout_ns);
 
 void kbase_kmod_diag_sample_imports(const char *why);
+extern void (*kbase_kmod_atom_fail_cb)(unsigned atom);
 
 int kbase_kmod_csf_export_cqs64_fence(struct pan_kmod_dev *dev,
                                       const uint64_t *addrs,
diff --git a/src/panfrost/vulkan/jm/panvk_cmd_buffer.h b/src/panfrost/vulkan/jm/panvk_cmd_buffer.h
index 6c46f16..6171ae2 100644
--- a/src/panfrost/vulkan/jm/panvk_cmd_buffer.h
+++ b/src/panfrost/vulkan/jm/panvk_cmd_buffer.h
@@ -85,6 +85,11 @@ struct panvk_batch {
     * is issued again.
     */
    struct util_dynarray vary_infos;
+   /* Diagnostics: what this batch drew, logged if its atoms fail. */
+   struct {
+      uint32_t draws, gs, tess, xfb, fb_w, fb_h;
+      uint64_t max_verts;
+   } diag;
 };
 
 enum panvk_cmd_event_op_type {
diff --git a/src/panfrost/vulkan/jm/panvk_vX_cmd_draw.c b/src/panfrost/vulkan/jm/panvk_vX_cmd_draw.c
index fc37cc0..3e7a914 100644
--- a/src/panfrost/vulkan/jm/panvk_vX_cmd_draw.c
+++ b/src/panfrost/vulkan/jm/panvk_vX_cmd_draw.c
@@ -3164,6 +3164,22 @@ panvk_cmd_draw(struct panvk_cmd_buffer *cmdbuf, struct panvk_draw_data *draw)
    if (result != VK_SUCCESS)
       return;
 
+   {
+      struct panvk_batch *db = cmdbuf->cur_batch;
+      db->diag.draws++;
+      if (cmdbuf->state.gfx.gs.shader)
+         db->diag.gs++;
+      if (draw->tess_phase)
+         db->diag.tess++;
+      if (cmdbuf->state.gfx.xfb.active)
+         db->diag.xfb++;
+      uint64_t v = (uint64_t)draw->vertex_range * draw->info.instance.count;
+      if (v > db->diag.max_verts)
+         db->diag.max_verts = v;
+      db->diag.fb_w = cmdbuf->state.gfx.render.fb.layout.width_px;
+      db->diag.fb_h = cmdbuf->state.gfx.render.fb.layout.height_px;
+   }
+
    pan_pack_work_groups_compute(&draw->invocation, 1, draw->vertex_range,
                                 draw->info.instance.count, 1, 1, 1, true,
                                 false);
diff --git a/src/panfrost/vulkan/jm/panvk_vX_gpu_queue.c b/src/panfrost/vulkan/jm/panvk_vX_gpu_queue.c
index cb0d856..103185f 100644
--- a/src/panfrost/vulkan/jm/panvk_vX_gpu_queue.c
+++ b/src/panfrost/vulkan/jm/panvk_vX_gpu_queue.c
@@ -156,6 +156,35 @@ panvk_reset_issued_batch(struct panvk_cmd_buffer *cmdbuf,
    batch->issued = false;
 }
 
+
+/* Diagnostics: one line per kbase atom number describing the batch it ran,
+ * printed by kbase when that atom fails (kbase_kmod_atom_fail_cb). */
+static char panvk_diag_atoms[256][128];
+
+static void
+panvk_diag_atom_failed(unsigned atom)
+{
+   mesa_loge("panvk: failed atom %u ran: %s", atom,
+             panvk_diag_atoms[atom & 255][0] ? panvk_diag_atoms[atom & 255]
+                                             : "(unknown)");
+}
+
+static void
+panvk_diag_note_atom(uint64_t atom, const char *kind,
+                     const struct panvk_batch *batch)
+{
+   if (!atom)
+      return;
+   kbase_kmod_atom_fail_cb = panvk_diag_atom_failed;
+   snprintf(panvk_diag_atoms[atom & 255], sizeof(panvk_diag_atoms[0]),
+            "%s fb=%ux%u draws=%u gs=%u tess=%u xfb=%u max_verts=%llu "
+            "vtc_jobs=%u frag_jobs=%u",
+            kind, batch->diag.fb_w, batch->diag.fb_h, batch->diag.draws,
+            batch->diag.gs, batch->diag.tess, batch->diag.xfb,
+            (unsigned long long)batch->diag.max_verts,
+            batch->vtc_jc.job_index, batch->frag_jc.job_index);
+}
+
 static uint64_t
 panvk_queue_submit_batch(struct panvk_gpu_queue *queue,
                          struct panvk_cmd_buffer *cmdbuf,
@@ -208,6 +237,7 @@ panvk_queue_submit_batch(struct panvk_gpu_queue *queue,
             assert(vtc_atom);
             note_submitted(queue, vtc_atom);
             queue->last_vtc_atom = vtc_atom; /* v67b */
+            panvk_diag_note_atom(vtc_atom, "vtc", batch);
             queue->in_dep = 0;
             queue->last_any_atom = vtc_atom;
 
@@ -276,6 +306,7 @@ panvk_queue_submit_batch(struct panvk_gpu_queue *queue,
                                              false);
          assert(frag_atom);
          note_submitted(queue, frag_atom);
+         panvk_diag_note_atom(frag_atom, "frag", batch);
          queue->half_frag_atom[batch->heap_half & 1] = frag_atom; /* v67b */
          queue->last_frag_atom = frag_atom; queue->last_any_atom = frag_atom;
          if (!vtc_atom) {
diff --git a/src/util/u_gralloc/u_gralloc_fallback.c b/src/util/u_gralloc/u_gralloc_fallback.c
index 9a85d1c..37b0438 100644
--- a/src/util/u_gralloc/u_gralloc_fallback.c
+++ b/src/util/u_gralloc/u_gralloc_fallback.c
@@ -682,6 +682,29 @@ fallback_gralloc_get_buffer_info(struct u_gralloc *gralloc,
          return 0;
       }
       mesa_logw("Huawei gralloc: AFBC buffer cannot be imported");
+      return stable_ret;
+   }
+
+   /* Other vendors without a usable mapper (Samsung Exynos on AOSP 16 only
+    * has HIDL mapper 2.x): use the linear layout derived from the buffer
+    * description above.  PANVK_GRALLOC_GUESS_LINEAR=0 restores the refusal. */
+   if (stable_ret != 0) {
+      const char *g = getenv("PANVK_GRALLOC_GUESS_LINEAR");
+      if (!(g && g[0] == '0')) {
+         static bool logged;
+         if (!logged) {
+            mesa_logi("gralloc: no mapper metadata, importing as linear "
+                      "(stride %d)", stride);
+            logged = true;
+         }
+         out->drm_fourcc = drm_fourcc;
+         out->modifier = DRM_FORMAT_MOD_LINEAR;
+         out->num_planes = 1;
+         out->fds[0] = hnd->handle->data[0];
+         out->offsets[0] = 0;
+         out->strides[0] = stride;
+         return 0;
+      }
    }
 
    if (stable_ret != 0) {
-- 
2.43.0

