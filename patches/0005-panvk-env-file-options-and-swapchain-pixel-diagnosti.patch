@@ -288,6 +290,31 @@ panvk_init_dri_options(struct panvk_instance *instance)
                            });
 }
 
+/* Testing aid: KEY=VALUE lines from /sdcard/Download/panvk_env.txt are put
+ * in the environment when the driver is loaded, so options can be changed
+ * inside apps (Winlator) whose environment cannot be edited.  Only PANVK_*,
+ * PAN_* and MESA_* keys; existing variables are kept. */
+static void __attribute__((constructor))
+panvk_load_env_file(void)
+{
+   FILE *f = fopen("/sdcard/Download/panvk_env.txt", "r");
+   if (!f)
+      return;
+   char line[256];
+   while (fgets(line, sizeof(line), f)) {
+      line[strcspn(line, "\r\n")] = 0;
+      char *eq = strchr(line, '=');
+      if (!eq || line[0] == '#')
+         continue;
+      *eq = 0;
+      if (strncmp(line, "PANVK_", 6) && strncmp(line, "PAN_", 4) &&
+          strncmp(line, "MESA_", 5))
+         continue;
+      setenv(line, eq + 1, 0);
+   }
+   fclose(f);
+}
+
 VKAPI_ATTR VkResult VKAPI_CALL
 panvk_CreateInstance(const VkInstanceCreateInfo *pCreateInfo,
                      const VkAllocationCallbacks *pAllocator,
diff --git a/src/panfrost/vulkan/panvk_physical_device.c b/src/panfrost/vulkan/panvk_physical_device.c
index b3dfe8a..02d5b67 100644
--- a/src/panfrost/vulkan/panvk_physical_device.c
+++ b/src/panfrost/vulkan/panvk_physical_device.c
@@ -694,6 +694,7 @@ kbase_cpu_sync_signal(UNUSED struct vk_device *device, struct vk_sync *sync,
                       UNUSED uint64_t value)
 {
    struct kbase_cpu_sync *ks = container_of(sync, struct kbase_cpu_sync, sync);
+   kbase_kmod_diag_sample_imports("sync_signal");
    mtx_lock(&ks->mutex);
    ks->state = KBASE_CPU_SYNC_SIGNALED;
    ks->result = VK_SUCCESS;
@@ -1146,6 +1147,7 @@ kbase_cpu_sync_export_sync_file_jm(struct vk_device *device,
    if (result != VK_SUCCESS)
       return result;
 
+   kbase_kmod_diag_sample_imports("sync_export");
    *sync_file = -1;
    return VK_SUCCESS;
 }
