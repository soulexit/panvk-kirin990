+                dp[0] / secs, dp[1] / secs, dp[2] / secs, dp[3] / secs,
+                dp[4] / secs, dp[5] / secs, dp[6] / secs);
    }
    for (unsigned r = 0; r < 16; r++) {
       int best = -1;
diff --git a/src/panfrost/vulkan/panvk_priv_bo.h b/src/panfrost/vulkan/panvk_priv_bo.h
index fd1ed65..4a09635 100644
--- a/src/panfrost/vulkan/panvk_priv_bo.h
+++ b/src/panfrost/vulkan/panvk_priv_bo.h
@@ -54,6 +54,10 @@ struct panvk_mem_stats {
    uint64_t app_B, app_count, app_peak_B;
    /* Indexed draws recorded and their index counts (GPU profile report). */
    uint64_t draws_indexed, draw_indices;
+   /* Indexed draws by index range helper path: batched, not folded, VS
+    * writes memory, waits on an indirect job, tess/GS, multiview, batched
