+++ b/src/panfrost/vulkan/jm/panvk_vX_gpu_queue.c
@@ -260,6 +260,13 @@ panvk_gprof_report_locked(uint64_t now)
       const uint64_t ni = p_atomic_xchg(&panvk_mem_stats.draw_indices, 0);
       mesa_logi("GPROF draws: %.0f indexed draws/s recorded, avg %.0f indices",
                 nd / secs, nd ? (double)ni / nd : 0.0);
+      uint64_t dp[7];
+      for (unsigned k = 0; k < 7; k++)
+         dp[k] = p_atomic_xchg(&panvk_mem_stats.draw_path[k], 0);
+      mesa_logi("GPROF draw paths/s: batched idvs %.0f nofold %.0f vswrites %.0f "
