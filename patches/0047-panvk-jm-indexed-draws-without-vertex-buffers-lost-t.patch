From edd369f6704a00204b8509296939324d5fa8a1b6 Mon Sep 17 00:00:00 2001
From: soulexit <metehan.tanriverdi01@gmail.com>
Date: Thu, 29 Oct 2026 19:05:35 +0300
Subject: [PATCH 47/54] panvk/jm: indexed draws without vertex buffers lost
 their attribute table

Indexed (and indirect) draws allocate helper storage sized by the number
of vertex buffers. With none bound (vertex pulling, as DXVK 2.7 does),
that is a zero-sized allocation, which returns NULL: it was taken for an
allocation failure, panvk_draw_prepare_vs_attribs() returned early and
its caller ignored the error. The draw kept a stale or NULL attribute
table, so a VS with storage images or texel buffers (they live in that
table) read address 0 and the GPU faulted (DXVK 2.7: black window,
device lost). Only fail when something was requested, and propagate the
error.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/panfrost/vulkan/jm/panvk_vX_cmd_draw.c | 15 +++++++++++----
 1 file changed, 11 insertions(+), 4 deletions(-)

diff --git a/src/panfrost/vulkan/jm/panvk_vX_cmd_draw.c b/src/panfrost/vulkan/jm/panvk_vX_cmd_draw.c
index d9f3a0e..523a226 100644
--- a/src/panfrost/vulkan/jm/panvk_vX_cmd_draw.c
+++ b/src/panfrost/vulkan/jm/panvk_vX_cmd_draw.c
@@ -1151,7 +1151,9 @@ panvk_draw_prepare_vs_attribs(struct panvk_cmd_buffer *cmdbuf,
          cmdbuf, desc,
          num_vs_attribs * sizeof(struct libpan_draw_helper_attrib_info), 8);
 
-      if (!bufs_infos_storage.gpu ||
+      /* Zero-sized allocations return NULL: a VS without vertex buffers
+       * (vertex pulling) has no buffer infos. */
+      if ((num_vbs && !bufs_infos_storage.gpu) ||
           (num_vs_attribs && !attribs_infos_storage.gpu))
          return VK_ERROR_OUT_OF_DEVICE_MEMORY;
 
@@ -1217,16 +1219,19 @@ panvk_draw_prepare_vs_attribs(struct panvk_cmd_buffer *cmdbuf,
    return VK_SUCCESS;
 }
 
-static void
+static VkResult
 panvk_draw_prepare_attributes(struct panvk_cmd_buffer *cmdbuf,
                               struct panvk_draw_data *draw)
 {
-   panvk_draw_prepare_vs_attribs(cmdbuf, draw);
+   VkResult result = panvk_draw_prepare_vs_attribs(cmdbuf, draw);
+   if (result != VK_SUCCESS)
+      return result;
    draw->vs.attributes = cmdbuf->state.gfx.vs.attribs;
    draw->vs.attribute_bufs = cmdbuf->state.gfx.vs.attrib_bufs;
    draw->indirect_info.attribs = cmdbuf->state.gfx.vs.indirect_attribs_infos;
    draw->indirect_info.attrib_bufs =
       cmdbuf->state.gfx.vs.indirect_attrib_bufs_infos;
+   return VK_SUCCESS;
 }
 
 /* The scissor box of viewport i: the viewport rectangle cut by scissor i,
@@ -2210,7 +2215,9 @@ prepare_draw(struct panvk_cmd_buffer *cmdbuf, struct panvk_draw_data *draw)
    /* This allocates and initializes the image table, which we need before we
     * can copy descriptors.
     */
-   panvk_draw_prepare_attributes(cmdbuf, draw);
+   result = panvk_draw_prepare_attributes(cmdbuf, draw);
+   if (result != VK_SUCCESS)
+      return result;
 
    /* jm-v7 090: the VS storage-image attributes live in the attribute
     * table, which panvk_draw_prepare_vs_attribs() allocates anew for every
-- 
