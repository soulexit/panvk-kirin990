From 8115baceb021938fe68b02879a68704d446cadca Mon Sep 17 00:00:00 2001
From: soulexit <metehan.tanriverdi01@gmail.com>
Date: Tue, 27 Oct 2026 03:53:34 +0300
Subject: [PATCH 33/36] panvk: BIFROST_* keys and PANVK_STDERR_FILE in
 panvk_env.txt

The env file loader also takes BIFROST_* keys (compiler debug flags), and
PANVK_STDERR_FILE reopens stderr on that file, so shader dumps from an app
started by Winlator, whose stderr goes nowhere, can be collected.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/panfrost/vulkan/panvk_instance.c | 13 +++++++++++--
 1 file changed, 11 insertions(+), 2 deletions(-)

diff --git a/src/panfrost/vulkan/panvk_instance.c b/src/panfrost/vulkan/panvk_instance.c
index c6b3d08..a743e2c 100644
--- a/src/panfrost/vulkan/panvk_instance.c
+++ b/src/panfrost/vulkan/panvk_instance.c
@@ -293,7 +293,8 @@ panvk_init_dri_options(struct panvk_instance *instance)
 /* Testing aid: KEY=VALUE lines from /sdcard/Download/panvk_env.txt are put
  * in the environment when the driver is loaded, so options can be changed
  * inside apps (Winlator) whose environment cannot be edited.  Only PANVK_*,
- * PAN_*, MESA_* and heap_memory_percent; existing variables are kept. */
+ * PAN_*, MESA_*, BIFROST_* and heap_memory_percent; existing variables are
+ * kept. */
 static void __attribute__((constructor))
 panvk_load_env_file(void)
 {
@@ -314,11 +315,19 @@ panvk_load_env_file(void)
        * the same name, and the heap size sets DXVK's allocation chunk
        * size (256 MiB chunks above ~3.8 GiB of heap). */
       if (strncmp(key, "PANVK_", 6) && strncmp(key, "PAN_", 4) &&
-          strncmp(key, "MESA_", 5) && strcmp(key, "heap_memory_percent"))
+          strncmp(key, "MESA_", 5) && strncmp(key, "BIFROST_", 8) &&
+          strcmp(key, "heap_memory_percent"))
          continue;
       setenv(key, eq + 1, force);
    }
    fclose(f);
+
+   /* PANVK_STDERR_FILE=path: append the process' stderr (compiler shader
+    * statistics and disassembly with BIFROST_MESA_DEBUG) to a file, for
+    * apps like Winlator whose stderr goes nowhere. */
+   const char *errf = getenv("PANVK_STDERR_FILE");
+   if (errf && errf[0])
+      freopen(errf, "a", stderr);
 }
 
 /* Testing aid: PANVK_SELFPROF=1 starts an in-process sampling profiler.
-- 
