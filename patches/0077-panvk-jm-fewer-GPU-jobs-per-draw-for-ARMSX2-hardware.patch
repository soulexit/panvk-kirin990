+/* PANVK_IMG_LOG=1: one line per image with the layout it got (GPU profile:
+ * linear render targets and textures are slow to sample and to write). */
+static uint64_t
+panvk_image_get_mod(struct panvk_image *image,
+                    const VkImageCreateInfo *pCreateInfo)
+{
+   const uint64_t mod = panvk_image_get_mod_impl(image, pCreateInfo);
+   static int log = -1;
+   if (log < 0) {
+      const char *e = getenv("PANVK_IMG_LOG");
+      log = e && e[0] == '1';
+   }
+   if (log)
+      mesa_logi("IMGLOG fmt %d %ux%u mips %u layers %u samples %u tiling %d "
+                "usage 0x%x flags 0x%x -> mod 0x%" PRIx64 " (%s)",
+                image->vk.format, image->vk.extent.width,
+                image->vk.extent.height, image->vk.mip_levels,
+                image->vk.array_layers, image->vk.samples, image->vk.tiling,
+                (unsigned)image->vk.usage, (unsigned)image->vk.create_flags, mod,
+                drm_is_afbc(mod) ? "afbc"
+                : mod == DRM_FORMAT_MOD_LINEAR ? "LINEAR"
+                : "tiled");
+   return mod;
+}
