@@ -212,3 +213,25 @@ panvk_DestroyBuffer(VkDevice _device, VkBuffer _buffer,
 
    vk_buffer_destroy(&device->vk, pAllocator, &buffer->vk);
 }
+
+/* jm-v7 123: mark buffers that recorded transfer commands write (see
+ * panvk_buffer::gpu_written), then let the runtime lower the copy. */
+VKAPI_ATTR void VKAPI_CALL
+panvk_CmdCopyBuffer2(VkCommandBuffer commandBuffer,
+                     const VkCopyBufferInfo2 *pCopyBufferInfo)
+{
+   VK_FROM_HANDLE(panvk_buffer, dst, pCopyBufferInfo->dstBuffer);
+   if (dst)
+      dst->gpu_written = true;
+   vk_common_CmdCopyBuffer2(commandBuffer, pCopyBufferInfo);
+}
+
+VKAPI_ATTR void VKAPI_CALL
+panvk_CmdCopyImageToBuffer2(VkCommandBuffer commandBuffer,
+                            const VkCopyImageToBufferInfo2 *pCopyImageToBufferInfo)
+{
+   VK_FROM_HANDLE(panvk_buffer, dst, pCopyImageToBufferInfo->dstBuffer);
+   if (dst)
+      dst->gpu_written = true;
+   vk_common_CmdCopyImageToBuffer2(commandBuffer, pCopyImageToBufferInfo);
+}
