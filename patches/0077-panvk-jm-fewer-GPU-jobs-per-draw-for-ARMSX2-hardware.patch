 panvk_per_arch(meta_get_copy_desc_job)(
    struct panvk_cmd_buffer *cmdbuf,
@@ -420,6 +558,13 @@ panvk_per_arch(meta_get_copy_desc_job)(
          desc_info->others.count[i] +
          (i > 0 ? copy_info.desc_copy.limits[i - 1] : 0);
 
