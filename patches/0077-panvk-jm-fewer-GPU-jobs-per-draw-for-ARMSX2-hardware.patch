+/* jm-v7 122: the copies the desc_copy job would do, done on the CPU while
+ * recording. ARMSX2 needed about one such compute job for every draw (NFS
+ * Most Wanted: 3.25 hardware jobs per draw against 1.45 with the vendor
+ * driver, and 3.2x its vertex/tiler time). A descriptor set cannot change
+ * after it is bound unless a binding is UPDATE_AFTER_BIND, so its contents
+ * at record time are the ones the job would read. Mirrors single_desc_copy()
+ * exactly (out-of-range entries are zeroed). Falls back to the job for
+ * UPDATE_AFTER_BIND sets, direct texture/sampler tables, sets without a CPU
+ * mapping and tables this command buffer did not allocate.
+ * PANVK_DESC_COPY_CPU=0: always use the job (A/B). */
+static bool
+panvk_desc_copy_cpu_on(void)
+{
+   static int on = -1;
+   if (on < 0) {
+      const char *e = getenv("PANVK_DESC_COPY_CPU");
+      on = !(e && e[0] == '0');
+   }
+   return on;
+}
+
+static bool
+cpu_desc_copy(const struct panvk_shader_desc_info *desc_info,
+              const struct panvk_descriptor_state *desc_state,
+              const struct panvk_shader_desc_state *sds,
+              const uint32_t limits[PANVK_BIFROST_DESC_TABLE_COUNT],
+              uint32_t attrib_buf_idx_offset)
+{
+   if (!panvk_desc_copy_cpu_on() || desc_info->direct_mask)
+      return false;
+
+   const uint32_t *map = panvk_priv_mem_host_addr(desc_info->others.map);
+   if (!map)
+      return false;
+
+   for (uint32_t i = 0; i < PANVK_BIFROST_DESC_TABLE_COUNT; i++) {
+      if (desc_info->others.count[i] && !sds->tables_cpu[i])
+         return false;
+   }
+   if (desc_info->others.count[PANVK_BIFROST_DESC_TABLE_IMG] &&
+       !sds->img_attrib_table_cpu)
+      return false;
+
+   const uint32_t total = limits[PANVK_BIFROST_DESC_TABLE_COUNT - 1];
+   /* Validate every source set first: nothing is written on a fallback. */
+   for (uint32_t c = 0; c < total; c++) {
+      const uint32_t set_idx = COPY_DESC_HANDLE_EXTRACT_TABLE(map[c]);
+      if (set_idx >= MAX_SETS)
+         return false;
+      const struct panvk_descriptor_set *set = desc_state->sets[set_idx];
+      if (!set)
+         continue; /* the job reads set_desc_counts[] = 0: zeroes */
+      if (!set->descs.host ||
+          (set->layout && (set->layout->flags &
+                           VK_DESCRIPTOR_SET_LAYOUT_CREATE_UPDATE_AFTER_BIND_POOL_BIT)))
+         return false;
+   }
+
+   for (uint32_t c = 0; c < total; c++) {
+      const uint32_t set_idx = COPY_DESC_HANDLE_EXTRACT_TABLE(map[c]);
+      const uint32_t src_idx = COPY_DESC_HANDLE_EXTRACT_INDEX(map[c]);
+      const struct panvk_descriptor_set *set = desc_state->sets[set_idx];
+      const bool valid = set && src_idx < set->desc_count;
+      const uint32_t *src =
+         valid ? (const uint32_t *)((const uint8_t *)set->descs.host +
+                                    (size_t)src_idx * PANVK_DESCRIPTOR_SIZE)
+               : NULL;
+
+      if (c < limits[PANVK_BIFROST_DESC_TABLE_UBO]) {
+         const unsigned sz = sizeof(struct mali_attribute_packed);
+         uint8_t *dst = (uint8_t *)sds->tables_cpu[PANVK_BIFROST_DESC_TABLE_UBO] +
+                        (size_t)c * sz;
+         if (valid)
+            memcpy(dst, src, sz);
+         else
+            memset(dst, 0, sz);
+      } else if (c < limits[PANVK_BIFROST_DESC_TABLE_IMG]) {
+         const uint32_t d = c - limits[PANVK_BIFROST_DESC_TABLE_UBO];
+         const unsigned buf_sz = pan_size(ATTRIBUTE_BUFFER) * 2;
+         uint32_t *attrib = (uint32_t *)((uint8_t *)sds->img_attrib_table_cpu +
+                                         (size_t)d * pan_size(ATTRIBUTE));
+         uint32_t *abuf =
+            (uint32_t *)((uint8_t *)sds->tables_cpu[PANVK_BIFROST_DESC_TABLE_IMG] +
+                         (size_t)d * buf_sz);
+         if (!valid) {
+            memset(abuf, 0, buf_sz);
+            memset(attrib, 0, pan_size(ATTRIBUTE));
+            continue;
+         }
+         const uint32_t buf_idx = d * 2 + attrib_buf_idx_offset;
+         if ((src[0] & BITFIELD_MASK(5)) == MALI_ATTRIBUTE_TYPE_1D) {
+            /* Texel buffer */
+            attrib[0] = (src[4] & ~BITFIELD_MASK(9)) | buf_idx;
+            attrib[1] = src[5];
+            abuf[0] = src[0];
+            abuf[1] = src[1];
+            abuf[2] = src[2] & BITFIELD_MASK(7);
+            abuf[3] = src[3];
+            abuf[4] = abuf[5] = abuf[6] = abuf[7] = 0;
+         } else {
+            /* Image */
+            attrib[0] = buf_idx | (src[2] & 0xfffffc00);
+            attrib[1] = 0;
+            abuf[0] = src[0];
+            abuf[1] = src[1];
+            abuf[2] = src[2] & BITFIELD_MASK(7);
+            for (unsigned k = 3; k < 8; k++)
+               abuf[k] = src[k];
+         }
+      } else if (c < limits[PANVK_BIFROST_DESC_TABLE_TEXTURE]) {
+         const uint32_t d = c - limits[PANVK_BIFROST_DESC_TABLE_IMG];
+         const unsigned sz = sizeof(struct mali_texture_packed);
+         uint8_t *dst =
+            (uint8_t *)sds->tables_cpu[PANVK_BIFROST_DESC_TABLE_TEXTURE] +
+            (size_t)d * sz;
+         if (valid)
+            memcpy(dst, src, sz);
+         else
+            memset(dst, 0, sz);
+      } else if (c < limits[PANVK_BIFROST_DESC_TABLE_SAMPLER]) {
+         const uint32_t d = c - limits[PANVK_BIFROST_DESC_TABLE_TEXTURE];
+         const unsigned sz = sizeof(struct mali_sampler_packed);
+         uint8_t *dst =
+            (uint8_t *)sds->tables_cpu[PANVK_BIFROST_DESC_TABLE_SAMPLER] +
+            (size_t)d * sz;
+         if (valid)
+            memcpy(dst, src, sz);
+         else
+            memset(dst, 0, sz);
+      }
+   }
+   return true;
+}
