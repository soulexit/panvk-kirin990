+         const VkRenderingAttachmentInfo *a =
+            i < pRenderingInfo->colorAttachmentCount
+               ? &pRenderingInfo->pColorAttachments[i] : NULL;
+         const VkImageView v = a ? a->imageView : VK_NULL_HANDLE;
+         same = v == cmdbuf->prev_rp.color[i] &&
+                (!v || a->loadOp == VK_ATTACHMENT_LOAD_OP_LOAD);
+      }
+      const VkRenderingAttachmentInfo *zs =
+         pRenderingInfo->pDepthAttachment &&
+               pRenderingInfo->pDepthAttachment->imageView
+            ? pRenderingInfo->pDepthAttachment
+            : pRenderingInfo->pStencilAttachment;
+      const VkImageView zv = zs ? zs->imageView : VK_NULL_HANDLE;
+      same = same && zv == cmdbuf->prev_rp.zs &&
+             (!zv || zs->loadOp == VK_ATTACHMENT_LOAD_OP_LOAD);
+      if (same) {
+         p_atomic_inc(&panvk_mem_stats.rp_merge[0]);
+         const void *tail = list_is_empty(&cmdbuf->batches)
+            ? NULL
