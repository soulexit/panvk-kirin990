    p_atomic_inc(&panvk_mem_stats.batch_why[0]);
 
+   /* GPU profile: could this pass be merged into the previous one? */
+   if (cmdbuf->prev_rp.valid && !resuming) {
+      bool same = pRenderingInfo->colorAttachmentCount <= 8 &&
+                  !memcmp(&pRenderingInfo->renderArea, &cmdbuf->prev_rp.area,
