+/* GPU profile: SPIR-V hash of the batch's first fragment shader. */
+static inline void
+diag_note_fs(struct panvk_cmd_buffer *cmdbuf, struct panvk_batch *batch)
+{
+   if (batch->diag.fs_hash || !cmdbuf->state.gfx.fs.required)
+      return;
+   const struct panvk_shader_variant *fs =
+      panvk_shader_only_variant(get_fs(cmdbuf));
+   if (fs)
+      batch->diag.fs_hash = fs->diag_src_hash;
+}
+
 #endif
 
 static void
@@ -3262,6 +3275,7 @@ panvk_cmd_draw(struct panvk_cmd_buffer *cmdbuf, struct panvk_draw_data *draw)
    {
       struct panvk_batch *db = cmdbuf->cur_batch;
       db->diag.draws++;
+      diag_note_fs(cmdbuf, db);
       if (cmdbuf->state.gfx.gs.shader)
          db->diag.gs++;
       if (draw->tess_phase)
@@ -3394,6 +3408,7 @@ panvk_cmd_draw_indirect(struct panvk_cmd_buffer *cmdbuf,
       return;
 
    cmdbuf->cur_batch->diag.draws++;
+   diag_note_fs(cmdbuf, cmdbuf->cur_batch);
 
    struct panvk_batch *batch = cmdbuf->cur_batch;
    const struct vk_vertex_input_state *vi =
@@ -4344,15 +4359,35 @@ panvk_per_arch(CmdDraw)(VkCommandBuffer commandBuffer, uint32_t vertexCount,
  * adjacency), transform feedback, multiview or a vertex shader with side
  * effects keep the GPU search, and so do sparse ranges.
  */
+/* jm-v7 123: on by default for the PS2 emulators (ARMSX2 and its
+ * relatives), which write their index stream before recording each draw:
+ * NFS Most Wanted on a Galaxy A51 went from 15 to 17-18 fps with it. Off
+ * elsewhere; PANVK_V7_CPU_INDEX_RANGE=0/1 overrides both ways. */
+static bool
+cpu_index_range_app_default(void)
+{
+   const char *name = util_get_process_name();
+   if (!name)
+      return false;
+   static const char *const apps[] = {"armsx2", "aethersx2", "nethersx2",
+                                      "pcsx2"};
+   for (unsigned i = 0; i < ARRAY_SIZE(apps); i++) {
+      if (strcasestr(name, apps[i]))
+         return true;
+   }
+   return false;
+}
+
 static bool
 cpu_index_range_enabled(void)
 {
    static int v = -1;
    if (v < 0) {
       const char *e = getenv("PANVK_V7_CPU_INDEX_RANGE");
-      v = e && e[0] && e[0] != '0';
+      v = e && e[0] ? e[0] != '0' : cpu_index_range_app_default();
       if (v)
-         mesa_logi("panvk: CPU index range search on");
+         mesa_logi("panvk: CPU index range search on (%s)",
+                   e && e[0] ? "PANVK_V7_CPU_INDEX_RANGE" : "app profile");
    }
    return v;
 }
