+/* Depth bias of the polygon-mode passthrough (jm-v7 018): a triangle drawn
+ * as lines or points is still a polygon to Vulkan, but the tiler only
+ * biases triangles. Only the least representable value of the depth
+ * format is advertised (depthBiasControl), as llvmpipe computes it.
+ */
+static void
+v7_polygon_bias(const struct panvk_cmd_buffer *cmdbuf,
+                struct panvk_gs_push *gs)
+{
+   const struct vk_rasterization_state *rs =
+      &cmdbuf->vk.dynamic_graphics_state.rs;
+
+   if (!rs->depth_bias.enable)
+      return;
+
+   const VkFormat zfmt = cmdbuf->state.gfx.render.z_attachment.fmt;
+   const bool zfloat = zfmt == VK_FORMAT_D32_SFLOAT ||
+                       zfmt == VK_FORMAT_D32_SFLOAT_S8_UINT;
+   double r = 1.0;
+   if (!zfloat) {
+      /* No depth attachment: nothing is tested, any r will do. */
+      const unsigned bits = zfmt == VK_FORMAT_D16_UNORM ||
+                                  zfmt == VK_FORMAT_D16_UNORM_S8_UINT
+                               ? 16
+                               : 24;
+      r = 1.0 / ((1u << bits) - 1);
+   }
+
+   gs->polygon_bias_float = zfloat;
+   gs->polygon_bias_units = rs->depth_bias.constant_factor * r;
+   gs->polygon_bias_slope = rs->depth_bias.slope_factor;
+   gs->polygon_bias_clamp = rs->depth_bias.clamp;
+}
+
 /*
  * The geometry shader as a compute job between the vertex job (dep_job_id)
  * and the tiler job. Returns the job the tiler waits on, 0 on failure.
@@ -2765,6 +2812,9 @@ emit_gs_job(struct panvk_cmd_buffer *cmdbuf, struct panvk_draw_data *draw,
                           gfx_sysvals->viewport.offset.z},
    };
 
+   if (gs->gs.polygon)
+      v7_polygon_bias(cmdbuf, &sysvals.gs);
+
    struct panvk_shader_desc_state ds;
    unsigned copy_job;
    if (!emu_prepare_descs(cmdbuf, gs_shader, &sysvals, &ds, &copy_job))
@@ -4606,11 +4656,8 @@ panvk_per_arch(CmdDrawIndexedIndirect)(VkCommandBuffer commandBuffer,
    VK_FROM_HANDLE(panvk_cmd_buffer, cmdbuf, commandBuffer);
    VK_FROM_HANDLE(panvk_buffer, buffer, _buffer);
 
-   /* Because we don't currently advertise nullDescriptor for JM, it is only
-    * valid to draw with a null index buffer if the draw accesses 0 indices.
-    * For direct draws, this is covered by checks on instancedCount and
-    * indexCount. For indirect draws we need to add an additional check, under
-    * the assumption that if the index buffer is null, the draw must be empty.
+   /* A null index buffer is the zero page on v7 (CmdBindIndexBuffer2()),
+    * so a 0 size is a 0-byte buffer: nothing to draw.
     */
    if (drawCount == 0 || cmdbuf->state.gfx.ib.size == 0)
       return;
