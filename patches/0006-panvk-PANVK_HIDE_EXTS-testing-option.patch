From cadcb6466ce0a023d3492ee7c39f73911a3db058 Mon Sep 17 00:00:00 2001
From: soulexit <b@l>
Date: Sun, 25 Oct 2026 05:35:16 +0300
Subject: [PATCH] panvk: PANVK_HIDE_EXTS testing option

---
 src/panfrost/vulkan/panvk_physical_device.c | 23 +++++++++++++++++++++
 1 file changed, 23 insertions(+)

diff --git a/src/panfrost/vulkan/panvk_physical_device.c b/src/panfrost/vulkan/panvk_physical_device.c
index 02d5b67..e358977 100644
--- a/src/panfrost/vulkan/panvk_physical_device.c
+++ b/src/panfrost/vulkan/panvk_physical_device.c
@@ -1382,6 +1382,28 @@ fail:
 }
 
 #if defined(HAVE_PAN_KMOD_KBASE)
+/* Testing aid: PANVK_HIDE_EXTS=VK_EXT_a,VK_KHR_b hides device extensions
+ * (set from /sdcard/Download/panvk_env.txt inside Winlator). */
+static void
+panvk_hide_device_extensions(struct vk_device_extension_table *exts)
+{
+   const char *list = getenv("PANVK_HIDE_EXTS");
+   if (!list || !list[0])
+      return;
+   for (unsigned i = 0; i < VK_DEVICE_EXTENSION_COUNT; i++) {
+      const char *name = vk_device_extensions[i].extensionName;
+      size_t len = strlen(name);
+      for (const char *p = strstr(list, name); p; p = strstr(p + 1, name)) {
+         if ((p == list || p[-1] == ',') && (p[len] == ',' || p[len] == 0)) {
+            if (exts->extensions[i])
+               mesa_logi("panvk: hiding %s (PANVK_HIDE_EXTS)", name);
+            exts->extensions[i] = false;
+            break;
+         }
+      }
+   }
+}
+
 VkResult
 panvk_physical_device_init_kbase(struct panvk_physical_device *device,
                                  struct panvk_instance *instance,
@@ -1491,6 +1513,7 @@ panvk_physical_device_init_kbase(struct panvk_physical_device *device,
    struct vk_device_extension_table supported_extensions;
    panvk_arch_dispatch(arch, get_physical_device_extensions, device, instance,
                        &supported_extensions);
+   panvk_hide_device_extensions(&supported_extensions);
 
    struct vk_features supported_features;
    panvk_arch_dispatch(arch, get_physical_device_features, instance,
-- 
