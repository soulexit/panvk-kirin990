diff --git a/framework/platform/android/tcuAndroidExePlatform.cpp b/framework/platform/android/tcuAndroidExePlatform.cpp
new file mode 100644
index 0000000..c252244
--- /dev/null
+++ b/framework/platform/android/tcuAndroidExePlatform.cpp
@@ -0,0 +1,84 @@
+/* Headless Vulkan-only platform for DEQP_ANDROID_EXE builds (no WSI). */
+#include "tcuPlatform.hpp"
+#include "tcuFunctionLibrary.hpp"
+#include "vkPlatform.hpp"
+#include "vkWsiPlatform.hpp"
+#include "deMemory.h"
+#include <sys/utsname.h>
+
+namespace tcu
+{
+namespace androidexe
+{
+
+class VulkanLibrary : public vk::Library
+{
+public:
+    VulkanLibrary(const char *libraryPath)
+        : m_library(libraryPath != nullptr ? libraryPath : "libvulkan.so")
+        , m_driver(m_library)
+    {
+    }
+    const vk::PlatformInterface &getPlatformInterface(void) const
+    {
+        return m_driver;
+    }
+    const tcu::FunctionLibrary &getFunctionLibrary(void) const
+    {
+        return m_library;
+    }
+
+private:
+    const DynamicFunctionLibrary m_library;
+    const vk::PlatformDriver m_driver;
+};
+
+class VulkanPlatform : public vk::Platform
+{
+public:
+    vk::wsi::Display *createWsiDisplay(vk::wsi::Type) const
+    {
+        TCU_THROW(NotSupportedError, "WSI type not supported");
+    }
+    bool hasDisplay(vk::wsi::Type) const
+    {
+        return false;
+    }
+    vk::Library *createLibrary(LibraryType libraryType, const char *libraryPath) const
+    {
+        if (libraryType != LIBRARY_TYPE_VULKAN)
+            TCU_THROW(InternalError, "Unknown library type requested");
+        return new VulkanLibrary(libraryPath);
+    }
+    vk::Library *createLibrary(const char *libraryPath) const
+    {
+        return new VulkanLibrary(libraryPath);
+    }
+    void describePlatform(std::ostream &dst) const
+    {
+        utsname u;
+        deMemset(&u, 0, sizeof(u));
+        uname(&u);
+        dst << "OS: " << u.sysname << " " << u.release << " " << u.version << "\nCPU: " << u.machine << "\n";
+    }
+};
+
+class Platform : public tcu::Platform
+{
+public:
+    const vk::Platform &getVulkanPlatform(void) const
+    {
+        return m_vk;
+    }
+
+private:
+    VulkanPlatform m_vk;
+};
+
+} // namespace androidexe
+} // namespace tcu
+
+tcu::Platform *createPlatform(void)
+{
+    return new tcu::androidexe::Platform();
+}
